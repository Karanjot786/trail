{
  "name": "trail-analytics",
  "version": "0.2.0",
  "description": "Client SDK for Trail, self-hosted web analytics. Typed track/identify/reset/pageview plus React and Next.js components.",
  "keywords": ["analytics", "web-analytics", "trail", "self-hosted", "privacy", "nextjs", "react", "tracker"],
  "license": "MIT",
  "author": "Karanjot Singh",
  "homepage": "https://github.com/Karanjot786/trail#readme",
  "bugs": "https://github.com/Karanjot786/trail/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karanjot786/trail.git",
    "directory": "packages/trail-analytics"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
      "require": { "types": "./dist/react/index.d.cts", "default": "./dist/react/index.cjs" }
    },
    "./next": {
      "import": { "types": "./dist/next/index.d.ts", "default": "./dist/next/index.js" },
      "require": { "types": "./dist/next/index.d.cts", "default": "./dist/next/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "test": "vitest run",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
