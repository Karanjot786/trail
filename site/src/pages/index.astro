---
import Landing from '../layouts/Landing.astro'
import Hero from '../components/sections/Hero.astro'
import HowItWorks from '../components/sections/HowItWorks.astro'
import Journey from '../components/sections/Journey.astro'
import Bento from '../components/sections/Bento.astro'
import Privacy from '../components/sections/Privacy.astro'
import Numbers from '../components/sections/Numbers.astro'
import SelfHost from '../components/sections/SelfHost.astro'
import Mcp from '../components/sections/Mcp.astro'
import Faq from '../components/sections/Faq.astro'
import Cta from '../components/sections/Cta.astro'
import { meta, faq } from '../copy/landing'
import { SITE_URL, GITHUB_URL } from '../config'

const strip = (h: string) => h.replace(/<[^>]+>/g, '')
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Trail',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Linux, macOS, Windows',
    description: meta.description,
    url: new URL('/', SITE_URL).href,
    license: 'https://opensource.org/licenses/MIT',
    codeRepository: GITHUB_URL,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } })),
  },
]
---
<Landing title={meta.title} description={meta.description} jsonld={jsonld}>
  <Hero />
  <HowItWorks />
  <Journey />
  <Bento />
  <Privacy />
  <Numbers />
  <SelfHost />
  <Mcp />
  <Faq />
  <Cta />
</Landing>
