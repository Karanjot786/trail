---
interface Props {
  label: string;
  code: string;
}
const { label, code } = Astro.props;
---

<div class="code">
  <div class="code-bar">
    <span>{label}</span>
    <button type="button" class="copy" data-copy aria-label={`Copy ${label} snippet`}>Copy</button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<script>
  document.addEventListener('click', async (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-copy]');
    if (!b) return;
    const text = b.closest('.code')!.querySelector('code')!.textContent ?? '';
    try {
      await navigator.clipboard.writeText(text);
      b.textContent = 'Copied';
    } catch {
      b.textContent = 'Press ⌘C';
    }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  });
</script>
