---
// Hero demo: a faux Trail dashboard. Server-renders the finished journey (the poster);
// the client script then loops visitors arriving, a click into the journey, and back.
import { stories, journeyHTML } from '../lib/stories';
const a = stories[0];
const filler = [
  { w: 92, l: 64, src: 'google.com', v: 3, seen: '4m ago' },
  { w: 74, l: 80, src: 'direct', v: 1, seen: '9m ago' },
  { w: 100, l: 56, src: 't.co', v: 2, seen: '16m ago' },
  { w: 84, l: 70, src: 'google.com', v: 5, seen: '22m ago' },
];
---

<figure class="demo" data-demo>
  <div class="win" aria-hidden="true">
    <div class="topbar">
      <span class="site">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></svg>
        example.com
      </span>
      <span class="sep"></span>
      <span class="online"><span class="pulse"></span><span class="roll" data-online>3</span> online</span>
      <span class="range">Last 7 days
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m6 9 6 6 6-6"></path></svg>
      </span>
    </div>
    <div class="tabs"><span>Overview</span><span class="on">Visitors</span></div>

    <div class="scenes">
      <section class="scene s-list" data-scene="list">
        <div class="thead"><span>Person</span><span class="hide-s">Location</span><span class="hide-s">First source</span><span class="num">Visits</span><span>Last seen</span></div>
        <div class="rows" data-rows>
          <div class="row is-real" data-row>
            <span class="who"><span class="av"></span><b data-name>{a.name}</b></span>
            <span class="hide-s">{a.place}</span><span class="hide-s">{a.source}</span><span class="num">2</span><span data-seen>just now</span>
          </div>
          {filler.map((f) => (
            <div class="row" data-row>
              <span class="who"><span class="av"></span><span class="bar" style={`width:${f.w}px`}></span></span>
              <span class="hide-s"><span class="bar" style={`width:${f.l}px`}></span></span>
              <span class="hide-s">{f.src}</span><span class="num">{f.v}</span><span>{f.seen}</span>
            </div>
          ))}
        </div>
      </section>

      <section class="scene s-journey is-on" data-scene="journey">
        <div class="jhead">
          <span class="back" data-back>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 12H5m6-6-6 6 6 6"></path></svg>
            Visitors
          </span>
          <span class="jname" data-jname>{a.name}</span>
          <span class="badge is-on" data-badge>identified</span>
          <span class="jmeta hide-s" data-jmeta>{a.place}</span>
        </div>
        <div class="visit">
          <div class="day"><b>Today</b><span>Thu</span></div>
          <div class="flow">
            <span class="at" data-at>{a.at}</span>
            <div class="chips" data-chips set:html={journeyHTML(a.steps)} />
          </div>
        </div>
        <div class="visit earlier">
          <div class="day"><b data-pday>{a.prev.day}</b><span data-pwd>{a.prev.wd}</span></div>
          <div class="flow">
            <span class="at" data-pat>{a.prev.at}</span>
            <div class="chips" data-pchips set:html={journeyHTML(a.prev.steps)} />
          </div>
        </div>
      </section>
    </div>

    <svg class="cursor" data-cursor viewBox="0 0 24 24" width="22" height="22">
      <path d="M5 3.2v15.6l4.2-4 2.7 6.1 2.6-1.1-2.7-6h5.9z" fill="#fff" stroke="#000" stroke-width="1.3" stroke-linejoin="round"></path>
    </svg>
  </div>
  <figcaption class="sr-only">
    A Trail dashboard: a new visitor arrives in the Visitors list, the list opens into their journey from github.com through the home page,
    pricing and the install docs to a signup, and the visitor becomes identified.
  </figcaption>
  <button class="demo-toggle" type="button" data-toggle aria-pressed="false">Pause animation</button>
</figure>

<script>
  import { stories, stepHTML, LINK, journeyHTML } from '../lib/stories';

  const root = document.querySelector<HTMLElement>('[data-demo]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;

  if (!reduce.matches) start();
  else toggle.hidden = true;

  function start() {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector(s) as unknown as T;
    const win = q('.win');
    const cursor = q<SVGElement>('[data-cursor]');
    const rows = q('[data-rows]');
    const list = q('[data-scene="list"]');
    const journey = q('[data-scene="journey"]');
    const chips = q('[data-chips]');
    const online = q('[data-online]');
    let paused = false;
    let seen = true;
    let online_n = 3;

    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting;
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = paused ? 'Play animation' : 'Pause animation';
      sync();
    });
    const running = () => !paused && seen && !document.hidden;
    function sync() {
      for (const a of win.getAnimations({ subtree: true })) running() ? a.play() : a.pause();
    }

    // A timer that stops while paused or off screen.
    const wait = (ms: number) =>
      new Promise<void>((done) => {
        const tick = (t0: number) => {
          let left = ms;
          const step = (now: number) => {
            if (running()) left -= now - t0;
            t0 = now;
            left <= 0 ? done() : requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        requestAnimationFrame(tick);
      });

    let cx = 0;
    let cy = 0;
    const place = (x: number, y: number) => {
      cx = x;
      cy = y;
      cursor.style.transform = `translate(${x}px,${y}px)`;
    };
    async function move(el: Element, fx = 0.3, fy = 0.55) {
      const w = win.getBoundingClientRect();
      const r = el.getBoundingClientRect();
      const x = r.left - w.left + r.width * fx;
      const y = r.top - w.top + r.height * fy;
      const d = Math.hypot(x - cx, y - cy);
      const anim = cursor.animate(
        [{ transform: `translate(${cx}px,${cy}px)` }, { transform: `translate(${x}px,${y}px)` }],
        { duration: Math.min(1100, 380 + d * 1.4), easing: 'cubic-bezier(.45,0,.2,1)' },
      );
      if (!running()) anim.pause();
      place(x, y);
      await anim.finished;
    }
    async function click(el: Element) {
      cursor.classList.add('down');
      el.classList.add('press');
      await wait(150);
      cursor.classList.remove('down');
      el.classList.remove('press');
    }
    const show = (scene: HTMLElement) => {
      list.classList.toggle('is-on', scene === list);
      journey.classList.toggle('is-on', scene === journey);
    };
    function bump(n: number) {
      online_n = n;
      online.classList.remove('tick');
      void online.offsetWidth;
      online.textContent = String(n);
      online.classList.add('tick');
    }
    function rowFor(s: (typeof stories)[number]) {
      const r = document.createElement('div');
      r.className = 'row is-real is-new';
      r.dataset.row = '';
      r.innerHTML = `<span class="who"><span class="av"></span><b data-name>${s.anon}</b></span><span class="hide-s">${s.place}</span><span class="hide-s">${s.source}</span><span class="num">2</span><span data-seen>just now</span>`;
      return r;
    }

    // Poster is the finished journey of story 0. Start by going back to the list.
    place(win.clientWidth * 0.72, win.clientHeight * 0.86);
    cursor.classList.add('on');
    let i = 1;

    (async () => {
      await wait(2200);
      for (;;) {
        const back = q('[data-back]');
        await move(back, 0.4);
        await click(back);
        show(list);
        await wait(1300);

        const s = stories[i];
        i = (i + 1) % stories.length;
        for (const el of rows.querySelectorAll('[data-seen]')) el.textContent = el.textContent === 'just now' ? '2m ago' : '6m ago';
        const row = rowFor(s);
        rows.prepend(row);
        bump(online_n + 1);
        const all = rows.querySelectorAll('[data-row]');
        if (all.length > 5) all[all.length - 1].remove();
        await wait(1100);
        row.classList.remove('is-new');

        const name = row.querySelector('[data-name]')!;
        await move(name, 0.5);
        row.classList.add('hover');
        await wait(220);
        await click(row);
        row.classList.remove('hover');

        // Journey for this visitor, built step by step.
        q('[data-jname]').textContent = s.anon;
        q('[data-jmeta]').textContent = s.place;
        q('[data-at]').textContent = s.at;
        const badge = q('[data-badge]');
        badge.classList.remove('is-on');
        chips.innerHTML = '';
        q('[data-pday]').textContent = s.prev.day;
        q('[data-pwd]').textContent = s.prev.wd;
        q('[data-pat]').textContent = s.prev.at;
        q('[data-pchips]').innerHTML = journeyHTML(s.prev.steps);
        show(journey);
        await wait(450);
        for (const [k, step] of s.steps.entries()) {
          chips.insertAdjacentHTML('beforeend', (k ? LINK : '') + stepHTML(step));
          for (const el of chips.querySelectorAll(':scope > :not(.in)')) el.classList.add('in');
          if (step.k === 'id') {
            const nm = q('[data-jname]');
            nm.classList.add('swap');
            await wait(160);
            nm.textContent = s.name;
            nm.classList.remove('swap');
            badge.classList.add('is-on');
            row.querySelector('[data-name]')!.textContent = s.name;
          }
          await wait(step.k === 'page' ? 720 : 520);
        }
        await move(q('.visit.earlier'), 0.7, 0.3);
        await wait(2600);
      }
    })();
  }
</script>
