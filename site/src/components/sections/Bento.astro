---
// Six-card bento (D1). Port of prototype index.html 250–376 and styles.css 263–350.
// The panel contents are illustrative product UI and live here; card text comes from the copy file.
import { bento } from '../../copy/landing'

const card = Object.fromEntries(bento.cards.map((c) => [c.id, c]))
type Item =
  | { k: 'chip'; text: string; t?: string; s?: string }
  | { k: 'out' | 'left' | 'idn' | 'ev'; text: string }
// Journey rows of the hero card: [date, weekday, [time, items][]]. Arrows go between chips, as in the dashboard.
const days: [string, string, [string, Item[]][]][] = [
  ['Nov 18', 'Wed', [
    ['21:07', [{ k: 'chip', text: 'news.ycombinator.com' }, { k: 'chip', text: '/', t: '22s', s: '↓64%' }, { k: 'chip', text: '/docs/quickstart', t: '2m4s', s: '↓80%' }, { k: 'out', text: 'github.com' }]],
    ['23:40', [{ k: 'chip', text: 'direct' }, { k: 'chip', text: '/pricing', t: '41s', s: '↓55%' }, { k: 'left', text: 'left' }]],
  ]],
  ['Nov 19', 'Thu', [
    ['09:42', [{ k: 'chip', text: 'direct' }, { k: 'chip', text: '/docs/installation', t: '3m10s', s: '↓92%' }, { k: 'idn', text: 'identified' }, { k: 'ev', text: 'Signup' }]],
  ]],
  ['Nov 20', 'Fri', [
    ['10:15', [{ k: 'chip', text: 'direct' }, { k: 'chip', text: '/docs/goals', t: '1m12s', s: '↓70%' }, { k: 'left', text: 'left' }]],
  ]],
]
const icon = { out: 'i-ext', left: 'i-out', idn: 'i-user', ev: 'i-zap' } as const
// The prototype numbers every child of a row (arrows included) for the hover walk; an arrow precedes chip/left items after the first.
const row = (items: Item[]) => {
  let k = 0
  return items.map((it, i) => ({ it, arrow: i > 0 && it.k !== 'out' && it.k !== 'ev', ka: i > 0 && it.k !== 'out' && it.k !== 'ev' ? k++ : -1, k: k++ }))
}
---
<section id="features" class="features sec">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>{bento.h2}</h2>
    </div>
    <div class="bento">
      <article class="card hero-card" data-reveal>
        <div class="tx">
          <span class="lbl">{card.hero.lbl}</span>
          <h3>{card.hero.h3}</h3>
          <p set:html={card.hero.p} />
        </div>
        <div class="pic">
          <div class="idsat" role="img" aria-label="The identify call">
            <code>trail.identify(<span class="s">"user_1204"</span>)</code>
            <span>Joins this browser's visits into one person.</span>
          </div>
          <div class="ui win jcard" role="img" aria-label="Journey of one visitor: four visits over three days, identified on Nov 19, then Signup">
            <div class="wbar"><span class="back"><svg class="i" aria-hidden="true"><use href="#i-back"/></svg>Visitors</span><b class="who">user_1204</b><span class="badge">identified</span><span class="muted">4 visits over 3 days</span></div>
            {days.map(([d, wd, sessions]) => (
              <div class="day"><div class="d"><b>{d}</b><span>{wd}</span></div><div class="sess">
                {sessions.map(([time, items]) => (
                  <div class="sl"><time>{time}</time><div class="row">
                    {row(items).map(({ it, arrow, ka, k }) => (
                      <Fragment>
                        {arrow && <svg class="i arr" aria-hidden="true" style={`--k:${ka}`}><use href="#i-chev"/></svg>}
                        {it.k === 'chip'
                          ? <span class="chip" style={`--k:${k}`}>{it.text}{it.t && <Fragment> <span class="t">{it.t}</span><span class="s">{it.s}</span></Fragment>}</span>
                          : <span class={it.k} style={`--k:${k}`}><svg class="i" aria-hidden="true"><use href={`#${icon[it.k]}`}/></svg>{it.text}</span>}
                      </Fragment>
                    ))}
                  </div></div>
                ))}
              </div></div>
            ))}
          </div>
        </div>
      </article>

      <article class="card live-card" data-reveal style="--d:1">
        <div class="tx">
          <span class="lbl">{card.live.lbl}</span>
          <h3>{card.live.h3}</h3>
          <p set:html={card.live.p} />
        </div>
        <div class="pic"><div class="ui panel">
          <div class="phead"><span class="online"><i></i>3 online</span><span class="subtle">last 5 min</span></div>
          <ul class="plist">
            <li><span>/docs/installation</span><span class="subtle">just now</span></li>
            <li><span>/pricing</span><span class="subtle">40s ago</span></li>
            <li><span>/</span><span class="subtle">2m ago</span></li>
          </ul>
        </div></div>
      </article>

      <article class="card goals-card" data-reveal style="--d:2">
        <div class="tx">
          <span class="lbl">{card.goals.lbl}</span>
          <h3>{card.goals.h3}</h3>
          <p set:html={card.goals.p} />
        </div>
        <div class="pic"><div class="ui panel">
          <ul class="bars">
            <li class="bar top" style="--w:100%"><span class="name">Signup<em class="reached">Goal reached</em></span><span class="v"><span class="num">353</span><span class="num">39.5%</span></span></li>
            <li class="bar" style="--w:80%"><span class="name">Pricing page</span><span class="v"><span class="num">284</span><span class="num">31.8%</span></span></li>
            <li class="bar" style="--w:22%"><span class="name">Copy Code</span><span class="v"><span class="num">78</span><span class="num">8.7%</span></span></li>
            <li class="addg"><svg class="i" aria-hidden="true"><use href="#i-plus"/></svg>Add goal</li>
          </ul>
        </div></div>
      </article>

      <article class="card nc-card" data-reveal>
        <div class="tx">
          <span class="lbl">{card.nc.lbl}</span>
          <h3>{card.nc.h3}</h3>
          <p set:html={card.nc.p} />
          {card.nc.note && <p class="note">{card.nc.note}</p>}
        </div>
        <div class="pic"><div class="ui panel">
          <div class="nc-code"><code>&lt;button <span class="a">data-trail</span>=<span class="s">"Copy Code"</span>&gt;<br />&nbsp;&nbsp;Copy<br />&lt;/button&gt;</code></div>
          <div class="nc-row"><span class="fbtn"><svg class="i" aria-hidden="true"><use href="#i-copy"/></svg>Copy</span><svg class="i arr" aria-hidden="true"><use href="#i-chev"/></svg><span class="ev"><svg class="i" aria-hidden="true"><use href="#i-zap"/></svg>Copy Code</span><span class="nc-n subtle num">112 clicks</span></div>
        </div></div>
      </article>

      <article class="card origin-card" data-reveal style="--d:1">
        <div class="tx">
          <span class="lbl">{card.origin.lbl}</span>
          <h3>{card.origin.h3}</h3>
          <p set:html={card.origin.p} />
        </div>
        <div class="pic"><div class="ui panel">
          <p class="owarn"><svg class="i" aria-hidden="true"><use href="#i-warn"/></svg>3 events rejected from other origins.</p>
          <ul class="olist">
            <li><span>example.com</span><span class="y">allowed</span></li>
            <li><span>*.vercel.app</span><span class="y">allowed</span></li>
            <li class="no"><span>copycat-site.net</span><span class="n">403</span></li>
          </ul>
        </div></div>
      </article>

      <article class="card dh-card" data-reveal style="--d:2">
        <div class="tx">
          <span class="lbl">{card.dh.lbl}</span>
          <h3>{card.dh.h3}</h3>
          <p set:html={card.dh.p} />
        </div>
        <div class="pic"><div class="ui panel">
          <div class="phead"><span class="dht"><svg class="i" aria-hidden="true"><use href="#i-activity"/></svg>Delivery health</span><span class="subtle">7 days</span></div>
          <dl class="dhn"><div><dt>Events</dt><dd class="num">12,840</dd></div><div><dt>On a retry</dt><dd class="num">1.7%</dd></div></dl>
          <p class="dhp">A retry means the first send failed, often on a weak mobile connection.</p>
        </div></div>
      </article>
    </div>
  </div>
</section>

<style is:global>
/* Port of prototype styles.css 263–350 plus the bento lines of the responsive block. Global, every rule under .features. */
.features{background:var(--paper)}
.bento{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-auto-rows:384px;gap:24px}
.bento .card{position:relative;display:flex;flex-direction:column;min-width:0;border-radius:20px;background:#fff;border:1px solid #d3e0f5;overflow:hidden;isolation:isolate;transition:border-color 200ms ease,box-shadow 260ms var(--ease-out)}
.bento .card .tx{padding:28px 28px 0;display:flex;flex-direction:column;gap:6px}
.bento .lbl{font:600 12px/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--deep);margin-bottom:8px}
.bento .card h3{font-size:20px;letter-spacing:-.015em}
.bento .card p{font-size:15.5px;line-height:1.5;color:var(--ink-2);text-wrap:pretty}
.bento .card p code{font-size:14px;color:var(--ink)}
.bento .card p.note{font-size:13.5px;margin-top:6px}
.bento .card .pic{position:relative;flex:1;margin-top:28px}
.bento .card .panel{position:absolute;left:28px;right:28px;top:0;bottom:-28px;border-radius:12px;-webkit-mask-image:linear-gradient(#000 calc(100% - 72px),transparent calc(100% - 8px));mask-image:linear-gradient(#000 calc(100% - 72px),transparent calc(100% - 8px));box-shadow:0 1px 0 rgb(255 255 255 / .04) inset,0 20px 40px -24px rgb(7 40 100 / .5)}
.bento .panel .phead{display:flex;align-items:center;justify-content:space-between;height:44px;padding:0 14px;border-bottom:1px solid var(--ui-border);font-size:13.5px}
.bento .panel .subtle{color:var(--ui-subtle);font-size:12.5px}
.plist{list-style:none;padding:4px 0}
.plist li{display:flex;justify-content:space-between;align-items:center;gap:12px;height:44px;padding:0 14px;font-size:14px}
.plist li + li{border-top:1px solid rgb(31 31 31 / .8)}
.goals-card .bars{padding:12px}
.nc-code{padding:16px 14px;border-bottom:1px solid var(--ui-border);font:12.5px/1.6 var(--mono);color:var(--ui-fg);white-space:nowrap}
.nc-code .a{color:#6cb2ff}.nc-code .s{color:#b8e3c7}
.nc-row{display:flex;align-items:center;gap:10px;padding:18px 14px}
.fbtn{display:inline-flex;align-items:center;gap:6px;height:34px;padding:0 14px;border-radius:8px;background:#ededed;color:#0a0a0a;font-size:14px;font-weight:500;flex:none}
.fbtn svg{width:14px;height:14px}
.olist{list-style:none;padding:12px;display:flex;flex-direction:column;gap:6px}
.olist li{display:flex;justify-content:space-between;align-items:center;height:40px;padding:0 12px;border:1px solid var(--ui-border);border-radius:8px;background:var(--ui-card);font:13px var(--mono)}
.olist .y{color:var(--ui-good);font:12.5px var(--sans)}
.olist .n{font:600 12px var(--sans);color:#ff8a8c;background:#2a0f10;border-radius:4px;padding:2px 6px}
.olist li.no{border-color:#3a1a1b}
.dht{display:flex;align-items:center;gap:8px}
.dhn{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:12px}
.dhn div{border:1px solid var(--ui-border);border-radius:8px;padding:12px 14px;background:var(--ui-card);display:flex;flex-direction:column;gap:6px}
.dhn dt{font-size:13px;color:var(--ui-muted)}
.dhn dd{font-size:30px;font-weight:600;letter-spacing:-.03em;line-height:1}
.bento .panel .dhp{padding:0 14px 14px;font-size:13px;line-height:1.5;color:var(--ui-muted);text-wrap:pretty}
.bento .panel .owarn{display:flex;gap:8px;align-items:flex-start;margin:12px 12px 0;padding:9px 12px;border:1px solid #5a4512;background:#1f1806;color:#f5c451;border-radius:8px;font-size:13px;line-height:1.45}
.bento .panel .owarn svg{width:15px;height:15px;margin-top:1px}
.origin-card .olist{padding-top:10px}
.nc-n{margin-left:auto;font-size:12.5px;color:var(--ui-subtle);white-space:nowrap}
.goals-card .addg{height:40px}
/* the hero tile: the only accented ground */
.bento .hero-card{grid-column:span 2;grid-row:span 2;background:var(--blue);border-color:var(--blue);color:#fff}
.hero-card::before{content:"";position:absolute;inset:0;z-index:-1;background-image:radial-gradient(circle,rgb(255 255 255 / .22) 1.2px,transparent 1.7px);background-size:16px 16px;-webkit-mask-image:linear-gradient(170deg,transparent 30%,#000 90%);mask-image:linear-gradient(170deg,transparent 30%,#000 90%)}
.bento .hero-card .tx{padding:36px 40px 0}
.bento .hero-card .lbl,.bento .hero-card p,.bento .hero-card p code{color:#fff}
.bento .hero-card h3{font-size:30px;letter-spacing:-.025em}
.bento .hero-card p{font-size:17px;max-width:30em}
.bento .hero-card .pic{margin-top:40px}
.jcard{position:absolute;left:40px;top:0;right:-1px;bottom:-1px;border-radius:12px 0 0 0;border-right:0;border-bottom:0;box-shadow:0 0 0 1px rgb(255 255 255 / .05),0 32px 64px -20px rgb(2 22 62 / .62)}
.jcard .wbar{height:56px;gap:14px;padding:0 20px}
.jcard .back{display:inline-flex;align-items:center;gap:6px;height:32px;padding:0 10px;border:1px solid var(--ui-border);border-radius:8px;font-size:13.5px}
.jcard .who{font-size:17px;font-weight:600;letter-spacing:-.02em}
.jcard .muted{font-size:13.5px}
.jcard .day .d{width:120px;padding:22px 20px}
.jcard .sl{padding:22px 18px}
.idsat{position:absolute;left:160px;bottom:40px;z-index:2;display:flex;flex-direction:column;gap:6px;padding:14px 18px;border-radius:12px;background:#fff;color:var(--ink);box-shadow:0 0 0 1px rgb(6 20 46 / .08),0 18px 36px -12px rgb(2 22 62 / .55),0 4px 10px -4px rgb(2 22 62 / .3)}
.idsat code{font-size:14px;color:var(--ink)}
.idsat code .s{color:#0b7a3b}
.idsat span{font-size:13.5px;color:var(--ink-2)}
/* hover: one small thing per tile, pointer devices only */
@media (hover:hover) and (pointer:fine){
  .bento .card:hover{border-color:#b6ccef;box-shadow:0 24px 48px -28px rgb(7 40 100 / .4)}
  .bento .hero-card:hover{border-color:var(--blue)}
}
@media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference){
  .hero-card:hover .jcard .row > :not(.arr){animation:bento-walk 900ms ease both;animation-delay:calc(var(--k,0) * 70ms)}
  .live-card:hover .online i::after{animation:bento-ping 1.2s var(--ease-out) infinite}
  .goals-card:hover .bar::before{animation:bento-fill 700ms var(--ease-out) both}
  .goals-card:hover .bar:nth-child(2)::before{animation-delay:70ms}
  .goals-card:hover .bar:nth-child(3)::before{animation-delay:140ms}
  .nc-card:hover .fbtn{animation:bento-press 380ms var(--ease-out)}
  .nc-card:hover .nc-row .ev{animation:bento-pop 420ms var(--ease-out) 160ms both}
  .origin-card:hover li.no{animation:bento-deny 520ms ease}
  .dh-card:hover .dhn div:last-child dd{animation:bento-pop 420ms var(--ease-out)}
}
@media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:reduce){
  .hero-card:hover .jcard .ev,.nc-card:hover .nc-row .ev{outline:1px solid #6cb2ff}
  .origin-card:hover li.no{background:#2a0f10}
  .live-card:hover .online i::after{opacity:.6}
}
@keyframes bento-walk{35%{border-color:#6cb2ff;box-shadow:0 0 0 1px #6cb2ff}}
@keyframes bento-ping{from{opacity:.9;transform:scale(.6)}to{opacity:0;transform:scale(1.7)}}
@keyframes bento-fill{from{transform:scaleX(.02)}}
@keyframes bento-press{40%{transform:scale(.94);background:#cfcfcf}}
@keyframes bento-pop{from{opacity:0;transform:translateX(-6px)}}
@keyframes bento-deny{20%,60%{transform:translateX(-3px);background:#2a0f10}40%,80%{transform:translateX(3px)}}

@media (max-width:1180px){
  .bento{grid-template-columns:repeat(2,minmax(0,1fr))}
  .bento .hero-card{grid-row:span 2}
  .bento .dh-card{grid-column:span 2}
}
@media (max-width:760px){
  .bento{grid-template-columns:1fr;grid-auto-rows:auto}
  .bento .hero-card,.bento .dh-card{grid-column:auto;grid-row:auto}
  .bento .card .pic{height:212px;flex:none}
  .bento .hero-card .pic{height:420px}
}
@media (max-width:700px){
  .bento .card .tx{padding:24px 24px 0}
  .bento .card .panel{left:24px;right:24px}
  .bento .hero-card .tx{padding:28px 24px 0}
  .bento .hero-card h3{font-size:26px}
  .bento .hero-card .pic{margin-top:24px;display:flex;flex-direction:column;height:auto}
  .idsat{position:relative;left:auto;bottom:auto;margin:0 24px 20px;align-self:flex-start}
  .idsat code{font-size:13px}
  .jcard{position:relative;left:auto;margin-left:24px;height:380px;overflow:hidden}
  .nc-n{display:none}
  .jcard .wbar{padding:0 14px;gap:10px}
  .jcard .wbar .muted{display:none}
  .jcard .day .d{width:auto;padding:16px 16px 0}
  .jcard .sl{padding:10px 16px 16px}
}
</style>
