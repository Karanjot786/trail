---
// Self-host (D3). Port of prototype index.html 479–552 and styles.css 426–495, with the deltas:
// the finder lists trail.db with its -wal and -shm files, and the backup text says how to copy safely.
import { selfhost } from '../../copy/landing'
import CopyButton from '../site/CopyButton.astro'

const s = selfhost
const tabs = Object.entries(s.deployTabs) as [keyof typeof s.deploy, string][]
---
<section id="self-host" class="selfhost sec">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>{s.h2}</h2>
      <p class="lede">{s.lede}</p>
    </div>
    <div class="sh2">
      <div class="tstage" id="tstage">
        <div class="twin" role="group" aria-label="Terminal running Trail in Docker">
          <div class="tbar"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl">{s.termTitle}</span><button class="skip" type="button" id="tskip">{s.skip}</button></div>
          <pre class="tout" id="tout">{s.term.map((l, i) => <span class:list={['tl', i === 2 && 'dim']} set:html={l} />)}</pre>
        </div>
        <div class="upcard" id="upcard" role="group" aria-label={`The dashboard at ${s.upcard.url}`}>
          <div class="ubar"><span class="url">{s.upcard.url}</span></div>
          <div class="ubody">
            <div class="uh"><b>{s.upcard.site}</b><span class="up"><i></i>{s.upcard.up}</span></div>
            <div class="ukpi">{s.upcard.kpis.map(([k, v]) => <div><span>{k}</span><b class="num">{v}</b></div>)}</div>
            <p class="uwait"><span class="wait"></span>{s.upcard.waiting}</p>
          </div>
        </div>
      </div>
      <div class="shside">
        <figure class="code deploy" id="shcode">
          <div class="code-head">
            <div class="tabs2" role="tablist" aria-label={s.deployLabel}>
              {tabs.map(([id, label], i) => (
                <button type="button" role="tab" id={`dt-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} aria-controls="shpre" data-tab={id}>{label}</button>
              ))}
            </div>
            <CopyButton label="Copy commands" from="shpre" />
          </div>
          <pre id="shpre" role="tabpanel" aria-labelledby="dt-docker" tabindex="0" data-docker={s.deploy.docker} data-fly={s.deploy.fly} data-bin={s.deploy.bin}><code>{s.deploy.docker}</code></pre>
        </figure>
        <dl class="shnums">
          {s.shnums.map((n) => <div><dt>{n.dt}</dt><dd>{n.dd}</dd></div>)}
        </dl>
      </div>
    </div>
    <div class="dbrow" data-reveal>
      <div class="finder" role="group" aria-label="The data folder">
        <div class="fbar2"><span class="lights" aria-hidden="true"><i></i><i></i><i></i></span><span class="ttl"><svg class="i" aria-hidden="true"><use href="#i-folder"/></svg>{s.finder.title}</span></div>
        <div class="frow hd">{s.finder.cols.map((c) => <span>{c}</span>)}</div>
        {s.finder.rows.map((r, i) => (
          <div class:list={['frow', i === 0 && 'sel', r.dim && 'dim']}><span><svg class="i" aria-hidden="true"><use href="#i-db"/></svg>{r.name}</span><span class="num">{r.size}</span><span>{r.kind}</span></div>
        ))}
        <p class="fnote">{s.finder.note}</p>
        <div class="fstat">{s.finder.status}</div>
      </div>
      <div class="dbtx">
        <h3>{s.db.h3}</h3>
        <p set:html={s.db.p} />
        <figure class="code bk">
          <div class="code-head"><span>{s.db.backupTitle}</span><CopyButton label="Copy command" text={s.db.backup} /></div>
          <pre><code>{s.db.backup}</code></pre>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>import '../../scripts/selfhost'</script>

<style is:global>
/* Port of prototype styles.css 426–495 plus the self-host lines of the responsive block. */
.selfhost{background:var(--ink);color:#fff;overflow:hidden;isolation:isolate}
.selfhost .head p{color:#d6e2f6}
.sh2{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:48px;align-items:start}
.tstage{position:relative;padding-bottom:112px}
.twin{border-radius:12px;background:#020b1c;border:1px solid rgb(255 255 255 / .14);overflow:hidden;box-shadow:0 32px 64px -24px rgb(0 0 0 / .6)}
.tbar,.fbar2{display:flex;align-items:center;gap:12px;height:40px;padding:0 10px 0 14px;font:12px var(--mono)}
.tbar{border-bottom:1px solid rgb(255 255 255 / .1);color:#a9bde0}
.selfhost .ttl{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap}
.skip{height:26px;padding:0 10px;border-radius:6px;border:1px solid rgb(255 255 255 / .22);background:none;color:#d6e2f6;font:500 12px var(--sans);cursor:pointer;transition:opacity 200ms ease,background-color 150ms ease,visibility 0s}
.skip:hover{background:rgb(255 255 255 / .08)}
.tstage:not([data-seq=pre]) .skip{opacity:0;visibility:hidden;pointer-events:none;transition:opacity 200ms ease,visibility 0s 200ms}
.tout{height:236px;margin:0;padding:16px 18px;font:13px/1.8 var(--mono);color:#e8f0ff;white-space:normal;overflow:hidden}
.tl{display:block;white-space:pre-wrap;overflow-wrap:anywhere}
.tout .pr{color:#9cc4ff}.tout .dim{color:#8ea6cf}.tout .hi{color:#7ee2a8}
.caret{display:inline-block;width:8px;height:15px;background:#e8f0ff;vertical-align:-2px}
@media (prefers-reduced-motion:no-preference){.caret{animation:sh-blink 1.1s steps(1) infinite}}
@keyframes sh-blink{50%{opacity:0}}
.tstage[data-seq=pre] .tl:not(.show){visibility:hidden}
.upcard{position:absolute;right:-28px;bottom:0;width:312px;border-radius:12px;background:#000;border:1px solid var(--ui-border-strong);color:var(--ui-fg);overflow:hidden;font:14px/1.4 var(--sans);box-shadow:0 0 0 1px rgb(255 255 255 / .04),0 24px 48px -16px rgb(0 0 0 / .7);transition:opacity 260ms ease,transform 320ms var(--ease-out)}
.tstage[data-seq=pre] .upcard:not(.show){opacity:0;transform:translateY(10px) scale(.98)}
.ubar{display:flex;align-items:center;justify-content:center;height:36px;border-bottom:1px solid var(--ui-border);background:#0a0a0a}
.upcard .url{font:12px var(--mono);color:var(--ui-muted);background:#161616;border-radius:999px;padding:3px 12px}
.ubody{padding:14px 16px 16px;display:flex;flex-direction:column;gap:12px}
.uh{display:flex;align-items:center;justify-content:space-between}
.uh b{font-weight:500}
.up{display:flex;align-items:center;gap:6px;font-size:12.5px;color:var(--ui-good)}
.up i{width:7px;height:7px;border-radius:50%;background:var(--ui-good)}
.ukpi{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--ui-border);border-radius:8px}
.ukpi div{padding:10px 12px;display:flex;flex-direction:column;gap:4px}
.ukpi div + div{border-left:1px solid var(--ui-border)}
.ukpi span{font-size:12.5px;color:var(--ui-muted)}
.ukpi b{font-size:22px;font-weight:600;line-height:1}
.uwait{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ui-muted)}
.deploy{border-color:rgb(255 255 255 / .14);background:#020b1c}
.deploy .code-head{border-color:rgb(255 255 255 / .12);color:#a9bde0}
.deploy pre{font-size:13px;color:#e8f0ff;min-height:170px;white-space:pre;overflow-x:auto}
.deploy pre:focus-visible{outline-offset:-4px}
.tabs2{display:flex;gap:4px}
.tabs2 button{height:28px;padding:0 10px;border-radius:6px;border:0;background:none;color:#a9bde0;font:500 12.5px var(--mono);cursor:pointer;transition:background-color 150ms ease,color 150ms ease}
.tabs2 button:hover{color:#fff}
.tabs2 button[aria-selected=true]{background:rgb(255 255 255 / .12);color:#fff}
.deploy .copy,.bk .copy{color:#a9bde0}
.deploy .copy:hover,.bk .copy:hover{background:rgb(255 255 255 / .08);color:#fff}
.shnums{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:28px;border-top:1px solid rgb(255 255 255 / .22)}
.shnums div{display:flex;flex-direction:column;gap:10px;padding:22px 12px 0 0}
.shnums div + div{padding-left:18px;border-left:1px solid rgb(255 255 255 / .14)}
.shnums dd{order:-1;font:900 40px/1 var(--dots);letter-spacing:.01em;white-space:nowrap;font-variant-numeric:tabular-nums}
.shnums dt{font-size:14px;line-height:1.4;color:#c9d7f0}
.dbrow{margin-top:56px;display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:48px;align-items:center}
.finder{border-radius:12px;background:#fff;color:var(--ink);overflow:hidden;font-size:14px;box-shadow:0 32px 64px -24px rgb(0 0 0 / .6)}
.fbar2{background:#eef3fa;border-bottom:1px solid #dbe4f1;color:var(--ink);font:600 13px var(--sans)}
.fbar2 .lights i{background:#c4d0e3}
.fbar2 .ttl svg{width:15px;height:15px;color:var(--blue)}
.frow{display:grid;grid-template-columns:minmax(0,1fr) 96px 150px;gap:12px;align-items:center;height:40px;margin:0 8px;padding:0 12px;border-radius:6px;white-space:nowrap}
.frow.hd{height:32px;margin:0 0 8px;padding:0 20px;border-radius:0;border-bottom:1px solid #e3e9f3;font-size:12px;color:#4e5f7d}
.frow:not(.hd) span:first-child{display:flex;align-items:center;gap:8px}
.frow svg{width:16px;height:16px;color:var(--blue)}
.frow.sel{background:var(--blue);color:#fff}
.frow.sel span:first-child{font-weight:500}
.frow.sel svg{color:#fff}
/* the SQLite working files: shown, greyed, not selectable */
.frow.dim{color:#4e5f7d;opacity:.6}
.frow.dim svg{color:currentColor}
.fnote{margin:6px 20px 0;padding-block:6px 2px;font-size:12.5px;line-height:1.45;color:#4e5f7d;text-wrap:pretty}
.fstat{margin-top:8px;padding:10px 20px;border-top:1px solid #e3e9f3;font-size:12px;color:#4e5f7d;background:#f7f9fd}
.dbtx{display:flex;flex-direction:column;gap:14px}
.dbtx h3{font-size:26px;letter-spacing:-.02em}
.dbtx p{font-size:17px;color:#d6e2f6;text-wrap:pretty}
.dbtx p code{font-size:15px;color:#fff}
.bk{border-color:rgb(255 255 255 / .14);background:#020b1c}
.bk .code-head{border-color:rgb(255 255 255 / .12);color:#a9bde0}
.bk pre{font-size:13px;color:#e8f0ff}

@media (max-width:900px){
  .sh2,.dbrow{grid-template-columns:minmax(0,1fr)}
  .sh2{gap:40px}
}
@media (max-width:700px){
  .tstage{padding-bottom:150px}
  .tout{height:300px;font-size:11.5px;padding:14px}
  .upcard{right:12px;width:280px}
  .shnums dd{font-size:28px}
  .shnums dt{font-size:13px}
  .deploy pre{font-size:11px}
  .shnums div + div{padding-left:12px}
  .frow{grid-template-columns:minmax(0,1fr) 80px}
  .frow span:nth-child(3){display:none}
  .fnote{margin-inline:16px}
}
</style>
