---
// Hero: build-time terrain (AVIF), inline footsteps SVG and HTML waypoint labels share one art box.
import { hero } from '../../copy/landing'
import { heroField, svg, waypoints } from '../../lib/art'
import { sizes } from '../../lib/numbers'
import { DEMO_URL } from '../../config'

const nums = hero.nums.flatMap((n) => {
  if (!n.size) return [{ dt: n.dt, dd: n.dd! }]
  const b = sizes[n.size]
  return b ? [{ dt: n.dt, dd: `${b.toLocaleString('en-US')} B` }] : []
})

// Labels follow the generator's placement (top = ly). A label beside its ring anchors the edge nearest the ring
// rather than its top-left corner: the text does not scale with the art box, so a corner anchor would drift onto
// the footprint. A label the generator moved above or below its ring keeps its top-left corner as given.
// lh: label height as % of the frame (about 41 px of 1000 on desktop, 36 px of 480 on phones).
const pct = (n: number, px = 0) => `calc(${n.toFixed(2)}% + ${px}px)`
const place = (x: number, y: number, r: number, lx: number, ly: number, lh: number) =>
  !(y - ly > 0 && y - ly < lh) ? { l: pct(lx), r: 'auto' } // above or below the ring
  : lx < x ? { l: 'auto', r: pct(100 - x + r, 12) } // left of the ring
  : { l: pct(x + r, 12), r: 'auto' } // right of the ring
const labels = waypoints.map((w) => {
  const d = place(w.x, w.y, w.r, w.lx, w.ly, 4.1), m = place(w.mx, w.my, w.mr, w.mlx, w.mly, 7.5)
  // Between the phone layout and 1180 px the legend is hidden, so every side label can sit right of its ring.
  const al = d.r === 'auto' ? d.l : pct(w.x + w.r, 12)
  return { ...w, style: `--al:${al};--dl:${d.l};--dr:${d.r};--dy:${w.ly}%;--ml:${m.l};--mr:${m.r};--my:${w.mly}%;--d:${w.delay + 90}ms` }
})
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-copy wrap">
    <h1 id="hero-title">{hero.h1}</h1>
    <p class="lede">{hero.lede}</p>
    <div class="ctas">
      <a class="btn btn-white" href={DEMO_URL}>{hero.ctaPrimary}</a>
      <a class="btn btn-ghost" href={hero.ctaSecondary.href}>{hero.ctaSecondary.text}</a>
    </div>
  </div>

  <div class="hero-art" aria-hidden="true">
    <picture>
      <source media="(max-width:700px)" type="image/avif" srcset={heroField.avifM} />
      <source media="(max-width:700px)" type="image/webp" srcset={heroField.webpM} />
      <source type="image/avif" srcset={`${heroField.avif1x} 1x, ${heroField.avif2x} 2x`} />
      <img src={heroField.webp} width="1600" height="1000" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="steps steps-d" set:html={svg.heroSteps} />
    <div class="steps steps-m" set:html={svg.heroStepsM} />
    {labels.map((w) => (
      <div class:list={['wp', { goal: w.goal }]} style={w.style}>
        {w.goal ? <b>{w.label}</b> : w.label}<span>{w.sub}</span>
      </div>
    ))}
  </div>

  <div class="hero-foot wrap">
    <dl class="nums" aria-label="Measured numbers">
      {nums.map((n) => <div><dt>{n.dt}</dt><dd>{n.dd}</dd></div>)}
    </dl>
    <aside class="legend" aria-label="Map legend">
      <b>{hero.legend.title}</b>
      <div>{hero.legend.sub}</div>
      {hero.legend.keys.map((k, i) => <div class="k"><i class={['', 'lw', 'lg'][i]}></i>{k}</div>)}
    </aside>
  </div>
</section>

<style>
  .hero{position:relative;min-height:max(780px,min(100dvh,940px));padding-top:var(--head-h);background:linear-gradient(#0a72ef,#0a6ae2 60%,#0650b0);color:#fff;overflow:hidden;isolation:isolate;display:flex;flex-direction:column}
  /* sky: a flat, faint dot grid above the art box, brightening toward the horizon */
  .hero::before{content:"";position:absolute;inset:0;z-index:-2;background-image:radial-gradient(circle,rgb(255 255 255 / .13) .9px,transparent 1.4px);background-size:18px 18px;-webkit-mask-image:linear-gradient(transparent,#000 60%);mask-image:linear-gradient(transparent,#000 60%)}

  /* The art keeps a 1100–1600 px box, centred: narrower screens crop its sides, wider ones fade its edges into the
     sky. Inside that range the route, the copy column and the legend keep the proportions the labels were placed for. */
  .hero-art{position:absolute;left:50%;bottom:0;width:clamp(1100px,100%,1600px);translate:-50% 0;aspect-ratio:1600 / 1000;z-index:-1;pointer-events:none}
  @media (min-width:1601px){
    .hero-art{-webkit-mask-image:linear-gradient(90deg,transparent,#000 14%,#000 86%,transparent);mask-image:linear-gradient(90deg,transparent,#000 14%,#000 86%,transparent)}
  }
  .hero-art img{display:block;width:100%;height:100%}
  .steps{position:absolute;inset:0}
  .steps :global(svg){display:block;width:100%;height:100%;overflow:visible}
  .steps-m,.steps-m :global(svg){display:none}
  .steps :global(.st){fill:#fff}
  .steps :global(.ring){transform-box:fill-box;transform-origin:center}

  .hero-copy{position:relative;z-index:2;padding-top:88px;width:100%}
  .hero h1{font-size:clamp(44px,5.3vw,74px);line-height:1.01;letter-spacing:-.04em;font-weight:620;max-width:9.6em}
  .hero .lede{margin-top:24px;color:#fff;max-width:28em}
  .ctas{margin-top:34px;display:flex;gap:12px;flex-wrap:wrap}

  .hero-foot{position:relative;z-index:2;margin-top:auto;padding-top:40px;padding-bottom:40px;display:flex;align-items:flex-end;justify-content:space-between;gap:32px;width:100%}
  .nums{display:flex;gap:44px}
  .nums div{display:flex;flex-direction:column;gap:8px}
  .nums dd{font:900 44px/1 var(--dots);letter-spacing:.01em;font-variant-numeric:tabular-nums;white-space:nowrap}
  .nums dt{font:500 13px/1.3 var(--mono);color:#fff;order:2}
  .legend{width:290px;border:1.5px solid #fff;border-radius:4px;background:rgb(6 20 46 / .78);backdrop-filter:blur(6px);padding:14px 16px 12px;font:12.5px/1.6 var(--mono);color:#fff}
  .legend b{display:block;font:600 13.5px var(--sans);margin-bottom:6px;letter-spacing:-.005em}
  .legend .k{display:flex;align-items:center;gap:10px}
  .legend .k i{flex:none;display:inline-grid;place-items:center;width:22px}
  .legend .k i::before{content:"";width:6px;height:6px;border-radius:50%;background:#fff;box-shadow:-8px 3px 0 -1px #fff,8px -3px 0 -1px #fff}
  .legend .k i.lw::before{width:10px;height:10px;background:none;border:2px solid #fff;box-shadow:none}
  .legend .k i.lg::before{width:12px;height:12px;background:none;border:2.5px solid var(--signal);box-shadow:none}

  /* waypoint chips over the art, placed in % of the art box */
  .wp{position:absolute;left:var(--dl);right:var(--dr);top:var(--dy);background:rgb(6 20 46 / .82);border:1px solid rgb(255 255 255 / .18);border-radius:8px;padding:6px 10px 7px;font:500 13px/1.35 var(--mono);color:#fff;white-space:nowrap;backdrop-filter:blur(4px)}
  .wp span{display:block;font-size:12px;color:#c7d8f7}
  .wp.goal{border-color:var(--signal)}
  .wp.goal b{color:var(--signal);font-weight:600}

  /* load sequence: footsteps one after another, each label as its footprint lands */
  @media (prefers-reduced-motion:no-preference){
    :global(.js) .steps :global(.st){opacity:0;animation:step 420ms var(--ease-out) forwards;animation-delay:calc(var(--i) * 38ms + 250ms)}
    :global(.js) .steps :global(.ring){opacity:0;animation:ring 600ms var(--ease-out) forwards;animation-delay:var(--d)}
    :global(.js) .wp{opacity:0;animation:lab 420ms var(--ease-out) forwards;animation-delay:var(--d)}
  }
  @keyframes step{from{opacity:0;transform:translateY(2px)}to{opacity:1;transform:none}}
  @keyframes ring{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:none}}
  @keyframes lab{from{opacity:0;translate:0 6px}to{opacity:1;translate:0 0}}

  @media (max-width:1180px){
    .nums{gap:28px}.nums dd{font-size:36px}
    .legend{display:none}
    .wp{left:var(--al);right:auto}
  }
  @media (max-width:1000px){
    .nums{display:grid;grid-template-columns:auto auto;gap:20px 28px}
  }
  /* phone: the art box drops into the flow between the CTAs and the numbers, with its own crop */
  @media (max-width:700px){
    .hero{min-height:0}
    .hero-copy{padding-top:36px}
    .hero h1{font-size:44px}
    .hero .lede{font-size:17.5px}
    .ctas .btn{flex:none}
    .hero-art{position:relative;left:auto;bottom:auto;width:100%;translate:none;aspect-ratio:390 / 480;z-index:0}
    .steps-d,.steps-d :global(svg){display:none}
    .steps-m,.steps-m :global(svg){display:block}
    .wp{left:var(--ml);right:var(--mr);top:var(--my);font-size:11.5px;padding:5px 8px}
    .wp span{font-size:11px}
    .hero-foot{padding-top:0;padding-bottom:48px}
    .nums{display:grid;grid-template-columns:1fr 1fr;gap:20px 16px;width:100%}
    .nums dd{font-size:32px}
  }
</style>
