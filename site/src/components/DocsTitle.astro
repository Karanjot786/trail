---
// Page title plus a "Copy page as Markdown" button that fetches the page's .md twin.
import Default from '@astrojs/starlight/components/PageTitle.astro';
const md = Astro.url.pathname.replace(/\/$/, '') + '.md';
---

<Default />
<button class="copy-md" type="button" data-md={md}>Copy page as Markdown</button>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-md]'))
    b.addEventListener('click', async () => {
      try {
        const text = await (await fetch(b.dataset.md!)).text();
        await navigator.clipboard.writeText(text);
        b.textContent = 'Copied';
      } catch {
        b.textContent = 'Copy failed. Open the .md link instead';
      }
      setTimeout(() => (b.textContent = 'Copy page as Markdown'), 1800);
    });
</script>
