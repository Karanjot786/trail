{
  "name": "trail-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:docs": "vitepress dev docs --host 127.0.0.1 --port 5173",
    "build": "astro build && vitepress build docs && cp dist/docs/404.html dist/404.html",
    "preview": "serve dist -l tcp://127.0.0.1:4173",
    "test:landing": "playwright test -c tests/landing/playwright.config.ts",
    "test:docs": "playwright test -c playwright.config.ts",
    "budget": "node scripts/js-budget.mjs",
    "lh": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "7.4.13",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "serve": "14.2.8",
    "vitepress": "2.0.0-alpha.21",
    "vitepress-plugin-llms": "1.15.0"
  }
}
