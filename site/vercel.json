{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/llms-small.txt", "destination": "/llms.txt", "permanent": true },
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/sitemap-0.xml", "destination": "/sitemap.xml", "permanent": true },
    { "source": "/docs/changelog.xml", "destination": "/changelog.xml", "permanent": true },
    { "source": "/docs/dashboard/visitors", "destination": "/docs/dashboard/activity", "permanent": true },
    { "source": "/docs/dashboard/goals", "destination": "/docs/dashboard/conversions", "permanent": true }
  ],
  "rewrites": [
    { "source": "/llms.txt", "destination": "/docs/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/docs/llms-full.txt" },
    { "source": "/sitemap.xml", "destination": "/docs/sitemap.xml" }
  ],
  "headers": [
    { "source": "/_astro/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/docs/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)\\.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }] }
  ]
}
